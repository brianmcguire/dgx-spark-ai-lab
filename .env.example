# Optional path to a local JSON profile. If omitted, the safe read-only
# config/default.json profile is used.
DASHBOARD_CONFIG=config/dashboard.local.json
HOST=127.0.0.1
PORT=4174
DASHBOARD_MODE=readonly
DGX_CONNECTION=local
DGX_HOST=local
PM2_COLLECTOR_ENABLED=false
GATEWAY_ENABLED=false
MODEL_CONTROLLER_ENABLED=false
SPARK_DOCTOR_ENABLED=false
VLLM_METRICS_URL=http://127.0.0.1:8000/metrics
VLLM_API_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=
AGENT_GATEWAY_API_URL=http://127.0.0.1:4010/v1
# Required for write APIs when full mode is enabled. The browser prompts once
# and stores the token in local browser storage.
DASHBOARD_CONTROL_TOKEN=
