{
  "name": "ai-operations-lab",
  "version": "1.3.0",
  "description": "Portable local dashboard for inference health, vLLM telemetry, model control, and repeatable benchmarks.",
  "main": "server/index.js",
  "scripts": {
    "dev": "node server/index.js",
    "start": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test": "node --test",
    "check": "npm test && npm run build",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ai-operations-lab",
    "pm2:logs": "pm2 logs ai-operations-lab"
  },
  "keywords": ["vllm", "dgx-spark", "llm", "inference", "monitoring", "benchmark"],
  "author": "Brian McGuire",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brianmcguire/dgx-spark-ai-lab.git"
  },
  "engines": { "node": ">=22" },
  "type": "module",
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vite": "^8.1.3"
  }
}
